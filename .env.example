# Environment Configuration
NODE_ENV=development
PORT=8000

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/budget_agents

# Redis (Upstash Redis / Local Redis)
REDIS_URL=redis://localhost:6379

# JWT Authentication
# ⚠️  LOCAL DEV ONLY — never use this value in production or Docker deployments.
#     Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#     docker-compose.yml reads JWT_SECRET from the HOST environment — set it there before `docker compose up`.
JWT_SECRET=super_secret_enterprise_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# AI Provider Configuration (Options: 'groq' | 'gemini' | 'openrouter' | 'mock')
# Groq is recommended as default for ultra-low latency live multi-agent rounds
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Client URL (CORS and Socket.IO)
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Auth Rate Limiting (applied to POST /api/auth/login and /api/auth/register)
# Defaults: 10 attempts per 15 minutes per IP. Override here to tune per environment.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
